        {
            "id": "dash_1771965639691",
            "name": "Temperatures",
            "metrics": [
                "livingroom_01.Sensor.SHT31.shtSensor.tempC",
                "office_johannes_01.Sensor.SHT31.shtSensor.tempC",
                "recroom_01.Sensor.SHT31.shtSensor.tempC",
                "recroom_01.Sensor.DS18B20.woodstove.tempC",
                "woodshed_01.Sensor.DS18B20.tempOutside.tempC",
                "woodshed_01.Sensor.DS18B20.battery.tempC",
                "woodshed_01.Sensor.BME280.controlBox.temperature"
            ]
        }
    ],
    "schedules": [
        {
            "name": "Ambient Glow After Sunset",
            "enabled": true,
            "trigger": {
                "type": "celestial",
                "event": "sunset",
                "offsetMinutes": 30
            },
            "targets": [
                {
                    "deviceId": "woodshed_01",
                    "subDevice": "rgbStrip",
                    "command": "setState",
                    "argument": true
                }
            ]
        },
        {
            "name": "Midnight Shutdown",
            "enabled": true,
            "trigger": {
                "type": "daily",
                "time": "23:55"
            },
            "targets": [
                {
                    "deviceId": "woodshed_01",
                    "subDevice": "rgbStrip",
                    "command": "setState",
                    "argument": false
                }
            ]
        },
        {
            "name": "Woodrack Lights after Sunset",
            "enabled": true,
            "trigger": {
                "type": "celestial",
                "event": "sunset",
                "offsetMinutes": 45
            },
            "targets": [
                {
                    "deviceId": "livingroom_01",
                    "subDevice": "woodRackLights",
                    "command": "setState",
                    "argument": true
                }
            ]
        },
        {
            "name": "Nightly Shutdown",
            "enabled": true,
            "trigger": {
                "type": "daily",
                "time": "22:30"
            },
            "targets": [
                {
                    "deviceId": "livingroom_01",
                    "subDevice": "woodRackLights",
                    "command": "setState",
                    "argument": false
                }
            ]
        },
        {
            "name": "Counter Lights Morning",
            "enabled": true,
            "trigger": {
                "type": "daily",
                "time": "07:00"
            },
            "targets": [
                {
                    "deviceId": "kitchen_01",
                    "subDevice": "counterLights",
                    "command": "setPercentage",
                    "argument": 60
                }
            ]
        },
        {
            "name": "Counter Lights Evening",
            "enabled": true,
            "trigger": {
                "type": "daily",
                "time": "20:30"
            },
            "targets": [
                {
                    "deviceId": "kitchen_01",
                    "subDevice": "counterLights",
                    "command": "setPercentage",
                    "argument": 30
                }
            ]
        },
        {
            "name": "Counter Lights Night",
            "enabled": true,
            "trigger": {
                "type": "daily",
                "time": "22:00"
            },
            "targets": [
                {
                    "deviceId": "kitchen_01",
                    "subDevice": "counterLights",
                    "command": "setPercentage",
                    "argument": 5
                }
            ]
        }
