            "log": false
        },
        "location": {
            "latitude": 55.3244,
            "longitude": -123.0928
        },
        "mqtt": {
            "brokerUrl": "http://server.wnet.wn",
            "brokerPort": 1883,
            "username": null,
            "password": null
        }
    },
    "actions": [
        {
            "name": "Woodstove Status LED",
            "enabled": true,
            "plugin": "woodstoveStateLed",
            "interval": 30000,
            "options": {
                "log": true,
                "sourceDevice": "recroom_01",
                "sourceKey": "data.Sensor.DS18B20.woodstove.woodstoveState",
                "targetDevice": "recroom_01",
                "targetSubDevice": "woodstoveStatusLed",
                "stateToCommandMap": {
                    "off": {
                        "setR": 0,
                        "setG": 0,
                        "setB": 0,
                        "setState": false,
                        "setPercentage": 0
                    },
                    "cooldown": {
                        "setR": 0,
                        "setG": 0,
                        "setB": 255,
                        "setState": true,
                        "setPercentage": 1
                    },
                    "warumup": {
                        "setR": 100,
                        "setG": 0,
                        "setB": 0,
                        "setState": true,
                        "setPercentage": 1
                    },
                    "running": {
                        "setR": 0,
                        "setG": 255,
                        "setB": 0,
                        "setState": true,
                        "setPercentage": 2
                    },
                    "refuel": {
                        "setR": 255,
                        "setG": 0,
                        "setB": 0,
                        "setState": true,
                        "setPercentage": 20
                    }
                },
                "_lastState": "warmup"
            }
        },
        {
            "name": "Humidistat Office Johannes",
            "enabled": true,
            "plugin": "humidistat",
            "interval": 60000,
            "options": {
                "log": "debug",
                "sourceDevice": "office_johannes_01",
                "sourceKey": "data.Sensor.SHT31.shtSensor.humidity",
                "targetDevice": "office_johannes_01",
                "targetSubDevice": "humidifier",
                "setPoint": 35,
                "hysteresis": 4,
                "tankDevice": "office_johannes_01",
                "tankKey": "data.Sensor.Capacitive.humidifierTank",
                "tankEmptyThreshold": 60,
                "tankRefillThreshold": 50
            }
        }
    ],
    "dashboards": [
        {
            "id": "dash_1771887905770",
            "name": "Favourites",
            "metrics": [
                "recroom_01.Sensor.DS18B20.woodstove.woodstoveState",
                "recroom_01.Sensor.DS18B20.woodstove.tempC",
                "woodshed_01.DeviceControl.RGB.rgbStrip.isOn",
