                "woodshed_01.Sensor.DS18B20.tempOutside.tempC",
                "woodshed_01.System.BatteryMonitor.batteryMonitor.voltageRaw"
            ]
        },
        {
            "id": "dash_1771888734383",
            "name": "Humidity",
            "metrics": [
                "livingroom_01.Sensor.SHT31.shtSensor.humidity",
                "recroom_01.Sensor.SHT31.shtSensor.humidity",
